# Obtain from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID permitted to use the personal bot.
ALLOWED_TELEGRAM_USER_ID=

# Persistent host path. Docker maps this to /app/data.
DATA_DIR=./data

# PostgreSQL is a separate service with a persistent Docker volume.
POSTGRES_DB=receipts
POSTGRES_USER=receiptbot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://receiptbot:replace-with-a-long-random-password@postgres:5432/receipts

# Conservative auto-approval threshold for OCR-derived fields.
OCR_CONFIDENCE_THRESHOLD=0.90
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-tc-big-sh-en

# Optional AI categorization. Leave empty for the local heuristic classifier.
CATEGORY_OPENAI_API_KEY=
CATEGORY_OPENAI_MODEL=gpt-4.1-mini

# QR verification requests. Keep the default official Serbian TaxCore hosts.
QR_ALLOWED_HOSTS=suf.purs.gov.rs,tap.suf.purs.gov.rs,*.suf.purs.gov.rs
QR_TIMEOUT_SECONDS=20
QR_MAX_RESPONSE_BYTES=2000000
