# Obtain from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID permitted to use the personal bot.
ALLOWED_TELEGRAM_USER_ID=

# Persistent host path. Docker maps this to /app/data.
DATA_DIR=./data
DATABASE_PATH=./data/receipts.sqlite3

# Conservative auto-approval threshold for OCR-derived fields.
OCR_CONFIDENCE_THRESHOLD=0.90
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-tc-big-sh-en
